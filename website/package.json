{
  "name": "soundswitch-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "docs:dev": "npm run sync:changelog && vuepress dev src",
    "docs:build": "npm run sync:changelog && vuepress build src",
    "deploy": "npm run docs:build && wrangler deploy",
    "preview": "npm run docs:build && wrangler dev"
  },
  "dependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "sass-embedded": "^1.100.0",
    "vue": "^3.5.40",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  },
  "devDependencies": {
    "@vuepress/plugin-llms": "^2.0.0-rc.132",
    "@vuepress/plugin-slimsearch": "^2.0.0-rc.130",
    "wrangler": "^4.114.0"
  }
}
