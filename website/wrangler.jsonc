{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soundswitch",
  "compatibility_date": "2026-05-08",
  "main": "worker/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "DOWNLOADS_TRACKER",
        "class_name": "DownloadsTracker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DownloadsTracker"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "15 2 * * *"
    ]
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "assets": {
    "directory": "src/.vuepress/dist/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "IPN_DEDUPE",
      "id": "42b6d9bab6c046ef906bf02ac68df459"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SITE_HOSTNAME": "https://soundswitch.aaflalo.me",
    "PAYPAL_IPN_MODE": "live"
  },
  // Cloudflare Workers Previews (`wrangler preview`, needs Wrangler >= 4.135). A Preview
  // never talks to production: the vars are placeholders and the Durable Object binding
  // is declared because the code reads it from `env` (each Preview still gets its own
  // automatically-provisioned namespace and storage).
  //
  // The IPN_DEDUPE KV is intentionally NOT bound here: Previews bind KV by a real
  // namespace id (Cloudflare error 10041 when it does not exist) and auto-provisioning
  // only covers Durable Objects and Containers — a placeholder id would fail the whole
  // preview deploy ("KV namespace '…' not found", Cloudflare error code 10041). Donations are
  // not exercised on Previews; the endpoint degrades gracefully
  // ("IPN_DEDUPE KV binding is not configured" in donations.ts). To re-enable it one
  // day, create a dedicated `soundswitch-preview` KV namespace and reference its real
  // id under `previews.kv_namespaces`.
  "previews": {
    "vars": {
      "SITE_HOSTNAME": "https://preview.example.com",
      "PAYPAL_IPN_MODE": "sandbox"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "DOWNLOADS_TRACKER",
          "class_name": "DownloadsTracker"
        }
      ]
    },
    "placement": {
      "mode": "smart"
    }
  }
}